# MyCloset Environment Variables

# Anthropic API Key (required for image analysis and recommendations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL (optional, defaults to SQLite)
# DATABASE_URL=sqlite:///./mycloset.db

# ============================================
# Gmail Import (Optional)
# ============================================
# To enable Gmail import, you need to:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a project and enable Gmail API
# 3. Create OAuth 2.0 credentials (Web application type)
# 4. Add http://localhost:8000/api/gmail/callback as authorized redirect URI
# 5. Download credentials and save as credentials.json in project root
